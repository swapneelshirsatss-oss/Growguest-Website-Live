# =======================================================================
# GrowGuest — Production LiteSpeed / Apache .htaccess Configuration
# Domain: https://growguest.in
# =======================================================================

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Permanent 301 Redirects for Legacy / Alias Routes
RewriteRule ^about/?$ /about-hospitality-marketing-agency/ [R=301,L]
RewriteRule ^services/?$ /hotel-digital-marketing-services/ [R=301,L]
RewriteRule ^contact/?$ /contact-hospitality-digital-marketing-agency/ [R=301,L]
RewriteRule ^contact-us/?$ /contact-hospitality-digital-marketing-agency/ [R=301,L]
RewriteRule ^contact-hospitality-marketing-agency/?$ /contact-hospitality-digital-marketing-agency/ [R=301,L]
RewriteRule ^direct-booking-solutions/?$ /hotel-direct-booking-solutions/ [R=301,L]
RewriteRule ^free-audit/?$ /free-hotel-digital-marketing-audit/ [R=301,L]
RewriteRule ^hotel-marketing-case-studies/?$ /hospitality-marketing-case-studies/ [R=301,L]
RewriteRule ^blog/?$ /hospitality-digital-marketing-blog/ [R=301,L]

# 3. Trailing Slash Enforcement (for directories and non-file URLs)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]+)$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://growguest.in/$1/ [L,R=301]

# 4. Browser Caching & Cache-Control (Core Web Vitals Boost)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & Feeds (short cache for freshness)
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType application/json "access plus 1 day"

  # Images & Vector Assets (long cache)
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS, JavaScript & Web Fonts (hashed assets)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 1-Year Immutable Caching for Static Hashed Assets
  <FilesMatch "\.(avif|webp|png|jpg|jpeg|gif|svg|woff|woff2|css|js)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML Freshness
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 5. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
